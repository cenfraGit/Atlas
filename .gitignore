# build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
artifacts/
TestResults/
*.user
*.suo

# the layout cache: records the absolute path of the folder it scanned, so it
# is machine specific and must never be committed. Atlas notices a cache from
# another machine and rescans rather than drawing it.
# not anchored to the root: running the app with its build output somewhere
# unusual writes the cache beside whatever the working directory was, and a
# machine specific file is no more committable for having landed in app/
data/

# ide
.vs/
.idea/
.vscode/

# os
Thumbs.db
desktop.ini
.DS_Store

# uitest screenshots, if someone points -OutDir at the repo
atlas_uitest/
