<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Atlas</AssemblyName>
    <RootNamespace>Atlas</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- the exe's own icon, in explorer and on a pinned taskbar button -->
    <ApplicationIcon>atlas.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <!-- and the window's, top left and in the taskbar while it runs -->
    <AvaloniaResource Include="atlas.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- so a test can reach a hook like InlineEditor.SetTextForTest without
         it having to be public on a type the app exposes -->
    <InternalsVisibleTo Include="Atlas.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.22" />
    <PackageReference Include="Avalonia.Skia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>
</Project>
